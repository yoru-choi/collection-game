# API Base URL (백엔드 서버 주소)
# Leave empty to use same-origin defaults in production builds.
# Set in .env.development for local dev.

# Environment
VITE_ENV=production

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false

# Asset Mode (OpenGameArt.org - PRD 1.6)
# 'hotlink' for development (fast prototyping with CDN links)
# 'local' for production (downloaded and bundled assets)
VITE_ASSETS_MODE=local
