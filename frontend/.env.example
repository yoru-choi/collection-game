# API Base URL (백엔드 서버 주소)
# Development: http://localhost:8080
# Production: https://api.yourgame.com
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL
# Development: ws://localhost:8080
# Production: wss://api.yourgame.com
VITE_WS_URL=ws://localhost:8080

# Environment
VITE_ENV=development

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=true

# Asset Mode (OpenGameArt.org - PRD 1.6)
# 'hotlink' for development (fast prototyping with CDN links)
# 'local' for production (downloaded and bundled assets)
VITE_ASSETS_MODE=hotlink
