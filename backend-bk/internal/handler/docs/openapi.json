      },
      "post": {
        "tags": ["Guilds"],
        "summary": "Create guild",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Created" } }
      }
    },
    "/api/v1/guilds/{id}": {
      "get": {
        "tags": ["Guilds"],
        "summary": "Get guild",
        "security": [{ "bearerAuth": [] }],
