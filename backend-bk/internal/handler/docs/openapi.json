              }
            }
          }
        }
      }
    },
    "/api/v1/dungeons": {
      "get": {
        "tags": ["Dungeons"],
        "summary": "Get dungeons",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Dungeons" } }
      }
    },
    "/api/v1/dungeons/{id}": {
      "get": {
        "tags": ["Dungeons"],
        "summary": "Get dungeon detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [ { "$ref": "#/components/parameters/IdPath" } ],
        "responses": { "200": { "description": "Dungeon detail" } }
      }
    },
    "/api/v1/dungeons/{id}/enter": {
      "post": {
