      }
    },
    "/api/v1/shop/items": {
      "get": {
        "tags": ["Shop"],
        "summary": "Get shop items",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Items" } }
      }
    },
    "/api/v1/shop/purchase": {
      "post": {
        "tags": ["Shop"],
        "summary": "Purchase item",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Purchased" } }
      }
    },
    "/api/v1/shop/history": {
      "get": {
        "tags": ["Shop"],
        "summary": "Get purchase history",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "History" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "schemas": {
      "ApiResponseAuth": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/AuthResponse" },
          "error": { "type": ["string", "null"] },
          "timestamp": { "type": "string" }
        }
      },
      "ApiResponseAuthToken": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/AuthTokenResponse" },
          "error": { "type": ["string", "null"] },
          "timestamp": { "type": "string" }
        }
      },
      "ApiResponseUser": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/User" },
          "error": { "type": ["string", "null"] },
          "timestamp": { "type": "string" }
        }
      },
      "ApiResponseMessage": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" },
          "error": { "type": ["string", "null"] },
          "timestamp": { "type": "string" }
        }
      },
      "ApiResponseObject": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" },
          "error": { "type": ["string", "null"] },
          "timestamp": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LevelUpRequest": {
        "type": "object",
        "required": ["exp_crystals"],
        "properties": {
          "exp_crystals": { "type": "integer", "minimum": 1 }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "authToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "authToken": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "level": { "type": "integer" },
          "exp": { "type": "integer" },
          "crystals": { "type": "integer" },
          "gold": { "type": "integer" },
          "energy": { "type": "integer" },
          "max_energy": { "type": "integer" },
          "last_login": { "type": "string" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "required": ["username", "email"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    }
  }
}
