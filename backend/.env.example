# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
GRPC_PORT=50051

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=collection_game
DB_SSLMODE=disable

# Redis/Valkey Configuration
